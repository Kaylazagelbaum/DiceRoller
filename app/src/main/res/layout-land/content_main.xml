<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/constraint_layout_padding_sides"
    android:paddingEnd="@dimen/constraint_layout_padding_sides"
    android:paddingTop="@dimen/constraint_layout_padding_top_and_bottom"
    android:paddingBottom="@dimen/constraint_layout_padding_top_and_bottom">

    <!-- Connect Four Board -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/square_background"
        android:padding="@dimen/grid_padding"
        app:columnCount="7"
        app:rowCount="6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/turnIndicator"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <!-- Game Status -->
    <TextView
        android:id="@+id/turnIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/textview_margin_top"
        android:gravity="center"
        android:padding="@dimen/textview_padding"
        android:text="@string/player_1_s_turn"
        android:textSize="@dimen/textview_text_size"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:background="@drawable/game_status_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/gridLayout"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
