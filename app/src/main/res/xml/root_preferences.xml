<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/display_header">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/night_mode_key"
            app:summaryOff="@string/night_mode_off"
            app:summaryOn="@string/night_mode_on"
            app:title="@string/night_mode_title" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/game_header">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/key_winner_message"
            app:summaryOff="@string/winner_message_on"
            app:summaryOn="@string/winner_message_off"
            app:title="@string/show_winner_message"/>

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/confetti_key"
            app:summaryOff="@string/confetti_on"
            app:summaryOn="@string/confetti_off"
            app:title="@string/confetti" />
    </PreferenceCategory>

</PreferenceScreen>